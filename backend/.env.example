# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase Postgres) -------------------------------------------
# Transaction pooler (app runtime, IPv4)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler — used by Prisma for migrations / db push
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# --- App ---------------------------------------------------------------------
PORT=3001

# Shared key required (as the x-admin-key header) on every admin route:
# /survey/* reads, /guides/*, /codes/*, /admin/recovery/*.
# If unset, those reads are open — always set it in deployed environments.
ADMIN_KEY="choose-a-long-random-string"

# --- Guide storage (Supabase Storage) ----------------------------------------
# When unset, guide PDFs and rendered pages fall back to a local .storage/
# folder, which is fine for development but is wiped on every Render deploy.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_BUCKET="guides"

# --- Access-code emails (Resend) ---------------------------------------------
# When unset, generated codes are logged to the server console instead of
# being emailed, so local development still works.
RESEND_API_KEY=""
MAIL_FROM="Tutor Connect <noreply@tutorconnect.ng>"
COURSES_URL="https://courses.tutorconnect.ng"
SUPPORT_EMAIL="support@tutorconnect.ng"
# Optional — international format, digits only (e.g. 2348012345678)
SUPPORT_WHATSAPP=""
