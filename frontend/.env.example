# Base URL of the TutorConnect backend API. Include the scheme — a bare host is
# a relative path to fetch(), which lands on this site's own SPA fallback.
# Dev default is http://localhost:3001; prod falls back to the Railway URL.
VITE_API_URL=http://localhost:3001

# Sales WhatsApp shown on the revision-guide CTA (digits only, intl format).
VITE_SALES_WHATSAPP=2347049460213
